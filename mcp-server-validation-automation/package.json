{
  "name": "Obot Acceptance Tests",
  "version": "1.0.0",
  "description": "WebDriverIO - Cucumber and Webdriverio automation test suite",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wdio:all": "wdio run wdio.conf.ts",
    "wdio:byScenario": "wdio run wdio.conf.ts --spec src/features/mcpServer.feature",
    "test:report": "npx allure generate --clean allure-results && npx allure open",
    "eval": "npx ts-node auto_eval.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/chai": "^5.2.3",
    "@types/node": "^22.20.1",
    "@wdio/allure-reporter": "^9.30.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/cucumber-framework": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "expect-webdriverio": "^5.7.0",
    "fix-esm": "^1.0.1",
    "openai": "^6.48.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webdriverio": "^9.30.0"
  },
  "overrides": {
    "reflect-metadata": "0.2.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
